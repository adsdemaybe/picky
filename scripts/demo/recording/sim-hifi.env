# Picky hi-fi recording: Isaac worker overrides. NOT APPLIED. Append to /data/advaiv2/picky/sim-judges.env
# (after a backup), then restart ONLY the Isaac worker (tmux picky-sim, /data/advaiv2/picky/run_sim_judges.sh).
# The gateway (picky-gw) does NOT need a restart for anything in this file.
# Rollback: restore the backup of sim-judges.env and restart picky-sim again (see RUN.md).

# ---- Tier A: env only (safe) ---------------------------------------------------------------------------------------
# Chase cam ("<robot>.director") render size. arms/sim/director.py _parse_size accepts 160x120 .. 1920x1080
# (anything bigger silently falls back to 640x480!). Was 960x540.
export PICKY_SIM_DIRECTOR_SIZE=1920x1080
# Director render rate. Clamped to 0.5..15 in arms/sim/director.py; the gateway's MJPEG is clamped to 15 too
# (arms/gateway/app.py MAX_STREAM_FPS) -> 15 unique fps is the ceiling; rec_hifi.py writes 30 fps CFR (duplicates).
# Was unset = 10.
export PICKY_SIM_DIRECTOR_FPS=15

# ---- Tier B: needs the 1-line hot patch in RUN.md step 1b (adds this env knob to arms/sim/app.py) ----------------
# JPEG quality of EVERY Isaac camera frame (director, ceiling, front/wrist/basket). Hard-coded 75 in
# arms/sim/app.py JPEG_QUALITY; the gateway passes director/ceiling JPEGs through untouched (perception is the fake,
# no re-encode), perceived overlays re-encode at 84 (arms/perception/perceived.py, gateway-side constant).
# Without the patch this line is ignored (harmless).
export PICKY_SIM_JPEG_QUALITY=92

# ---- NOT env knobs (left as they are tonight) -----------------------------------------------------------------------
# ceiling cams 640x480: data/fixtures/robots.yaml store_cameras[].mount.width/height (data read by BOTH gateway and
#   worker; needs a data edit + picky-gw AND picky-sim restart)                                   -> upscaled in edit
# robot cams front/wrist/basket 640x480: contracts/cameras.py CameraMount defaults (locked contract; the Perceptron
#   VLA / verifier prompts are tuned on 640x480)                                                   -> do not change
# robot + ceiling stream rate 5 fps: arms/robot/service.py SimRobot(stream_fps=5.0) in the GATEWAY (set_streams);
#   worker cap 15 (arms/sim/worker.py MAX_STREAM_FPS); no env knob                                  -> 5 fps, dup'd
