# Picky environment. Copy to .env (git-ignored) and fill in only the keys your arm needs.
# Read only through utils.config.settings. Every arm runs its fake unless listed in PICKY_REAL_ARMS.
# A listed arm whose prerequisites are missing (extra not installed, key blank) falls back to its fake at boot
# only if its create() checks them (catalog and messaging do); GET /health shows each arm's mode and why.

# --- Core / gateway --------------------------------------------------------------------------------
# Runtime environment (dev on laptops)
PICKY_ENV=dev
# Comma list of arms that run their REAL implementation; every other arm runs its fake.
# e.g. PICKY_REAL_ARMS=catalog,routing,trust   (blank = all fakes; `make demo` works with no keys)
PICKY_REAL_ARMS=
# Store the trip plans against: store_ave (main demo) | store_hill | online
PICKY_DEFAULT_STORE=store_ave
# Folder with products.yaml, planograms/, online_store.yaml, fixtures/
PICKY_DATA_DIR=data
# gateway: bind address and port for `make dev`
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
# Public URL of the gateway (frontend, messaging webhooks, and the sim worker connect here)
PICKY_GATEWAY_URL=http://localhost:8000

# --- Database (catalog, recommender) ---------------------------------------------------------------
# Local Docker Postgres + pgvector from `make db-up`. A Supabase URL works too (same driver).
DATABASE_URL=postgresql+psycopg://picky:picky@localhost:5432/picky

# --- LLM (agent, recommender, perception) ----------------------------------------------------------
# All LLM calls go through utils.llm. Leave the provider's key blank to use the fakes (no LLM calls).
# Provider: gemini (default; needs `uv sync --extra agent` for google-genai) | anthropic (Claude, optional)
PICKY_LLM_PROVIDER=gemini
# https://aistudio.google.com/apikey -> Create API key (used when PICKY_LLM_PROVIDER=gemini)
GEMINI_API_KEY=
# https://platform.claude.com -> API keys (used only when PICKY_LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# Model ids: brain = agent/planner tool loop, fast = voice/vision/classification, smart = hard reasoning.
# Blank = the provider default: gemini-3.8-flash / gemini-3.8-flash / gemini-4-argon
# (anthropic: claude-sonnet-5-5 / claude-haiku-5-5 / claude-opus-5-5).
PICKY_MODEL_BRAIN=
PICKY_MODEL_FAST=
PICKY_MODEL_SMART=
# Gemini thinking level for every call: minimal | low | medium | high (blank = model default, medium)
PICKY_GEMINI_THINKING=low
# Per-request LLM timeout in seconds (both providers)
PICKY_LLM_TIMEOUT_S=60

# --- Verifier vision (perception: planner -> VLA -> verifier loop) ---------------------------------
# Perceptron Mk1.5 key from https://platform.perceptron.inc (needs `uv sync --extra perception`). Blank = the
# ground-truth fake verifier. PICKY_VISION_PROVIDER=fake runs the real verifier with deterministic vision (no key).
PERCEPTRON_API_KEY=
PERCEPTRON_MODEL=perceptron-mk1.5
PERCEPTRON_BASE_URL=https://api.perceptron.inc/v1
PICKY_VISION_PROVIDER=perceptron
# decide | shadow | gt_only (blank = shadow on 2D-fake stores, decide on Isaac)
PICKY_VERIFIER_MODE=
# Cap per vision call in seconds (also bounded by each check's deadline)
PICKY_VISION_CALL_TIMEOUT_S=4

# --- Planner -> VLA -> verifier loop (agent runner, robot VLA, gateway) -----------------------------
# direct | plan | tools. Blank = plan (the gateway wires the VLA + verifier); direct = the exact v0.2 brain path.
PICKY_EXEC_MODE=
# Demo fault scenario at boot: drop_on_first_grasp | wrong_salsa | slow_vla | verifier_down | foggy_basket |
# flaky_t1 | isaac_drop (blank = no faults). `make demo` injects drop_on_first_grasp by itself.
PICKY_FAULTS=
# 1 = presenter routes on the gateway: /api/dev/faults (inject / load scenario / clear) and /api/dev/plans
PICKY_DEV=0
# Seconds: the LLM planner's draft call (scripted plan on timeout) and each verifier call
PICKY_PLAN_TIMEOUT_S=20
PICKY_VERIFY_TIMEOUT_S=8
# Extra VLA tiers: t1_pretrained (needs the policy server below) | t1_sim (simulated T1, breaker demo); blank = T0 only
PICKY_VLA_TIERS=
# T1 model id (blank = lerobot/smolvla_base) and, on the Isaac worker, its policy server
PICKY_VLA_T1_MODEL=
PICKY_VLA_POLICY_URL=
# openpi_ws (blank = default) | perceptron_tool (T1 grasps where Perceptron points; needs PERCEPTRON_API_KEY)
PICKY_VLA_POLICY_PROTOCOL=
# T1 grasp on the Isaac worker, joint by joint (contracts 0.2.2 ArmJointsCmd): perceptron (Perceptron Mk1.5 tool
# policy: PERCEPTRON_API_KEY + a worker with arm_ik) | perceptron_vla (robotics VLA service, team key) | smolvla |
# scripted | off. Blank = T1 off (unless the rules above enable it). Needs a worker with the arm_joints capability.
PICKY_VLA_T1=
# Policy-loop budget (s), max action chunks, rows executed per chunk, start pose (6 USD deg; blank = scripted stow),
# instruction template ({name} = product name, lower case)
PICKY_VLA_T1_TIMEOUT_S=25
PICKY_VLA_T1_MAX_CHUNKS=12
PICKY_VLA_T1_EXEC_STEPS=25
PICKY_VLA_T1_HOME_DEG=0,-100,90,50,45,7
PICKY_VLA_T1_INSTRUCTION="pick up the {name} and put it in the basket"
# Pictures while moving: side + wrist per second while a T1 chunk plays; front camera per second while driving
# (blurred, retained evidence; 0 = off); Perceptron look-out on the approach: isaac | always | off, within this path
# left (m); Perceptron calls per trip for the robot (T1 Mk1.5 policy + look-outs); per-call timeout (s)
PICKY_VLA_T1_CAPTURE_HZ=4
PICKY_VLA_NAV_CAPTURE_HZ=2
PICKY_VLA_NAV_LOOK=isaac
PICKY_VLA_NAV_LOOK_M=2.5
PICKY_PERCEPTRON_CALL_BUDGET=80
PICKY_VLA_MK15_TIMEOUT_S=12

# --- Perceptron robotics VLA (PICKY_VLA_T1=perceptron_vla; docs/vla-loop/perceptron-vla.md "Runbook") ------------
# Not Settings fields yet (the key lands as one with utils/keyvault, PR #18): arms/robot/perceptron_vla.py resolves
# them from the process env, then the vault (~/.config/picky/secrets.env, mode 600; macOS Keychain service "picky"),
# then this .env. Keep the key in the vault: `make secret NAME=PERCEPTRON_ROBOTICS_API_KEY` (with #18), check with
# `uv run python -m arms.robot.perceptron_vla doctor`.
# PERCEPTRON_ROBOTICS_API_KEY=        # TEAM key for https://robotics.perceptron.inc from Perceptron staff; NOT the
#                                     # Mk1.5 PERCEPTRON_API_KEY above (401 there). Unset = perceptron_vla T1 unavailable
# PERCEPTRON_ROBOTICS_BASE_URL=       # blank = https://robotics.perceptron.inc
# PERCEPTRON_ROBOTICS_DEPLOYMENT_ID=  # blank = the last successful `perceptron_vla pipeline` run
#                                     # (~/.cache/picky/perceptron-vla.json, ids only)

# --- Sim link (gateway <-> sim worker on the GPU box) ----------------------------------------------
# Shared token the Isaac sim worker sends when it connects to ws /ws/sim. Change it outside dev.
PICKY_SIM_TOKEN=dev-sim-token

# --- Sim worker on the GPU host (process env on vhagar: NOT read from .env; see arms/sim/DEPLOY.md) ---
# PICKY_SIM_STORES=store_ave,store_hill     # stores the worker hosts (default: every planogram)
# PICKY_SIM_WORKER_ID=isaac-vhagar
# PICKY_SIM_LABEL_DIR=/data/$USER/picky/labels
# PICKY_SO101_URDF=                          # experimental URDF import onto the primitive lift
# Optional visuals (arms/sim/ASSETS.md); unset = primitive boxes / rovers:
# PICKY_ASSET_ROOT=/data/$USER/picky-assets/products     # per-item grocery models (~3 GB, stays on vhagar)
# PICKY_SKU_ASSETS=                          # SKU -> model map (default $PICKY_DATA_DIR/sim/sku_assets.yaml)
# PICKY_SIM_ASSETS=off                       # force primitives even with PICKY_ASSET_ROOT set
# PICKY_ROVER_USD=/data/$USER/picky-assets/robots/picky-rover/picky_rover.usda   # LeKiwi + SO-101 + lift
# PICKY_SIM_AMBIENT=0.1                      # Isaac RTX ambient fill for the shelf interiors (0 = none)
# Dev-only chase camera + frame tee for demo videos (arms/sim/director.py; DEPLOY.md section 9); unset = off:
# PICKY_SIM_DIRECTOR=rover-ave-1             # robots to follow (comma-separated)
# PICKY_SIM_DIRECTOR_DIR=/data/$USER/picky/pvla-director   # frames: <dir>/<robot_id>/director/<epoch_ms>.jpg
# PICKY_SIM_DIRECTOR_FPS=4                   # frames/s per robot
# PICKY_SIM_DIRECTOR_VIEW=                   # back,side,z chase offsets in m (blank = the built-in view)

# --- Trust / payments (trust) ----------------------------------------------------------------------
# HMAC key for signing mandates, cart hashes and receipts. Change it outside dev.
PICKY_SIGNING_KEY=dev-signing-key
# Stripe TEST key (sk_test_...) from https://dashboard.stripe.com/test/apikeys. Leave blank for mock receipts.
STRIPE_SECRET_KEY=
# Visa Intelligent Commerce sandbox (https://developer.visa.com). Leave blank: the adapter routes to Stripe test.
VISA_API_KEY=
VISA_SHARED_SECRET=

# --- Messaging (messaging) -------------------------------------------------------------------------
# Photon 2.0 beta: https://app.beta.photon.codes -> project -> API key + Project ID (pho_prj_...).
# Leave blank to use the fake (web chat / terminal only).
PHOTON_API_KEY=
PHOTON_PROJECT_ID=

# --- Voice (agent) ---------------------------------------------------------------------------------
# https://console.deepgram.com (free credit). Leave blank: the frontend uses browser Web Speech instead.
DEEPGRAM_API_KEY=

# --- Recommender ---------------------------------------------------------------------------------
# Max optional recommendation detours per trip (the rest are batched at checkout)
PICKY_REC_MAX_STOPS=3

# --- Demo shopper (gateway server, fake messaging only) ---------------------------------------------
# 1 = a scripted shopper texts back YES/NO to every approval (incl. checkout) and answers the follow-up by itself.
# 0 (default) = approvals wait for a real click in the web app (or a real Photon text). `make demo` always scripts.
PICKY_SCRIPTED_SHOPPER=0

# --- Tooling knobs (process env only: NOT read from .env, not part of Settings) -------------------
# Set them on the command line, e.g. `PICKY_LOG_LEVEL=DEBUG make demo`.
# PICKY_LOG_LEVEL=INFO        # utils.log level (make demo defaults to WARNING so the timeline stays readable)
# PICKY_ID_SEED=42            # utils.ids seed for deterministic ids (make demo seeds 42)
