# Copy to .env.local (gitignored). Next.js reads env from this folder, not the repo root.
# Ask Picky uses Claude when set; without it, the chat answers offline from the same tools.
ANTHROPIC_API_KEY=
# T-Mobile site: Grok (xAI) is Magenta's in-store brain (/api/associate) and phrases Cart Whisperer reasons
# (/api/whisper). Without it both run on the built-in deterministic engine. Every $ amount Grok says is checked
# against the store data. PICKY_GROK_MODEL overrides the model.
XAI_API_KEY=
PICKY_GROK_MODEL=
# Optional natural voice for the robot (/api/tts): first one set wins; else the browser's best built-in voice.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
GEMINI_API_KEY=
# Optional: the Picky gateway (FastAPI, e.g. http://localhost:8000). Gateway mode = this URL is set AND its GET /health
# answers: robot orders go to POST /api/requests and the trip/live pages follow the real robot over /ws. Otherwise
# (empty, or the gateway is down) every screen runs on the demo data + in-browser replay. The TopBar chip shows which.
# Also used by `pnpm gen-types --live`. Optional direct robot stream (MJPEG/MP4) below.
NEXT_PUBLIC_GATEWAY_URL=
NEXT_PUBLIC_STREAM_URL=
# Optional: 1 = Home's "Running low" card always uses the demo-history rows instead of GET /api/users/maya/suggestions.
NEXT_PUBLIC_SUGGESTIONS_MOCK=
# Optional: 1 = Spending always shows the demo history instead of GET /api/users/maya/purchases.
NEXT_PUBLIC_PURCHASES_MOCK=
# Optional: 0 = no client-side purchase checks when the gateway sends none.
NEXT_PUBLIC_JUDGES_MOCK=
